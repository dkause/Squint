{
  "name": "squint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build:client": "esbuild public/swipe.ts --bundle --outfile=public/swipe.js --format=esm --target=es2022",
    "dev": "npm run build:client -- --watch=forever & tsx watch src/server.ts",
    "start": "npm run build:client && tsx src/server.ts",
    "deploy": "echo 'Deploy folgt in T9 (Infomaniak Node.js-Hosting, Konfiguration ueber Umgebungsvariablen)'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.2",
    "nodemailer": "^10.1.1",
    "sharp": "^0.35.5"
  }
}
