---
interface Props {
  title?: string;
  breadcrumbItems?: Array<{ name: string; href?: string }>;
}

const { title = "SQUINT", breadcrumbItems = [] } = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="SQUINT - Photo selection PWA" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Serif:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <header class="header">
      <a href="/" class="header__brand" aria-label="SQUINT Home">
        <span class="header__brand-name">SQUINT</span>
      </a>
    </header>
    
    <main class="main">
      {breadcrumbItems.length > 0 && (
        <Breadcrumb items={breadcrumbItems} />
      )}
      
      <slot />
    </main>

    <footer class="footer">
      <p class="footer__text">SQUINT - Photo Selection App</p>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :global(body) {
    font-family: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.5;
    color: rgba(0, 0, 0, 0.87);
    background-color: #ffffff;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .header {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
  }

  .header__brand {
    text-decoration: none;
    color: inherit;
  }

  .header__brand-name {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #000000;
  }

  .main {
    flex: 1;
    padding: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
  }

  .footer {
    padding: 1.5rem;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
    text-align: center;
  }

  .footer__text {
    font-size: 0.875rem;
    color: rgba(0, 0, 0, 0.6);
  }

  @media (max-width: 600px) {
    .main {
      padding: 1rem;
    }
    
    .header {
      padding: 1rem;
    }
  }
</style>
